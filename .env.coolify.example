# =============================================================================
# VARIABLES DE ENTORNO PARA COOLIFY  (app: NexaCRM)
#
# PegÃ¡ este bloque en Coolify -> tu app -> Environment (o "Stack" -> Variables).
# El compose (docker-compose.coolify.yml) arma solo DATABASE_URL y REDIS_URL a
# partir de POSTGRES_* y REDIS_PASSWORD: NO las definas a mano.
#
# IMPORTANTE sobre WhatsApp: si definis UNA sola variable WHATSAPP_*, la API
# exige las TRES (una integracion a medias es un error). Si no usas WhatsApp
# -> borra/comenta las tres y listo.
#
# IMPORTANTE: NEXT_PUBLIC_API_URL va HARCODEADO en el bundle del navegador.
# Cambiarlo exige RECONSTRUIR la imagen del web (redeploy).
# =============================================================================

# --- OBLIGATORIAS (sin valor por defecto: si faltan, el deploy NO arranca) ---
FRONTEND_URL=https://nexa.nexacrm.dpdns.org
INTERNAL_API_KEY=__CHANGE_ME__
JWT_SECRET=__CHANGE_ME__
JWT_REFRESH_SECRET=__CHANGE_ME__
JWT_2FA_PENDING_SECRET=__CHANGE_ME__
POSTGRES_PASSWORD=__CHANGE_ME__
REDIS_PASSWORD=__CHANGE_ME__

# --- Base de datos ---
POSTGRES_USER=nexa
POSTGRES_DB=nexacrm
# RLS: rol al que la API hace SET LOCAL ROLE en cada request (fail-closed).
# Lo crea la migracion 20260808120000_enable_rls. No cambiar salvo que se
# renombre el rol.
RLS_APP_ROLE=nexa_app

# --- Web ---
# RELATIVO: el browser llama al mismo origen y Next.js lo reenvia al contenedor
# de la API (API_URL=http://api:4000). Sin CORS y con las cookies de sesion
# funcionando. Si queda apuntando a un host viejo, el web sigue llamando ahi.
NEXT_PUBLIC_API_URL=/api/v1

# --- Demos de 7 dias (links de un click) ---
# Secret dedicado a los links de demo. Si se deja vacio, cae en JWT_SECRET.
JWT_DEMO_ACCESS_SECRET=__CHANGE_ME__

# --- Pagos ---
# La demo NO debe cobrar de verdad: con el proveedor stub, el checkout no cobra
# nada. Sin este flag la API se NIEGA a arrancar en produccion.
ALLOW_STUB_PAYMENT_IN_PROD=1
# Cuando tengas MercadoPago/Stripe reales: ALLOW_STUB_PAYMENT_IN_PROD=0 y
# PAYMENT_PROVIDER_KIND=mercadopago (o stripe).
PAYMENT_PROVIDER_KIND=stub

# --- Mercado Pago (opcional; vacio = proveedor inactivo) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX_MODE=true
MP_WEBHOOK_URL=https://nexa.nexacrm.dpdns.org/api/v1/automation/webhooks/mercadopago
MP_API_BASE_URL=https://api.mercadopago.com

# --- Stripe (opcional; vacio = proveedor inactivo) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- WhatsApp (opcional: o las TRES o ninguna) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=

# --- IA ---
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Email (opcional; vacio = no se envia correo) ---
RESEND_API_KEY=
EMAIL_FROM=Nexa CRM <noreply@nexacrm.com>

# --- Sentry (opcional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_HOST=sentry.io
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Storage S3/R2 (opcional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=auto
AWS_ENDPOINT=

# --- AFIP / facturacion electronica (opcional) ---
AFIP_ENABLED=false
AFIP_PROVIDER_KIND=stub
AFIP_CUIT=
AFIP_CERT_PATH=
AFIP_KEY_PATH=
AFIP_ENV=testing
ALLOW_STUB_AFIP_IN_PROD=

# --- Flags ---
WORKFLOWS_ENABLED=false
CORS_ORIGIN=https://nexa.nexacrm.dpdns.org
