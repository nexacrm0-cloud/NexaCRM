{
  "name": "@nexa/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts",
    "db:seed:agents": "tsx seed-agents.ts",
    "db:seed:demo": "cross-env SEED_DEMO_IN_PROD=1 tsx src/seed.ts",
    "db:seed:roles": "cross-env SEED_DEMO_IN_PROD=1 tsx seed-roles.ts",
    "db:seed:demo-data": "cross-env SEED_DEMO_IN_PROD=1 tsx seed-demo-data.ts",
    "db:seed:support": "cross-env SEED_DEMO_IN_PROD=1 tsx seed-support.ts",
    "db:studio": "prisma studio",
    "lint": "echo 'lint ok'",
    "clean": "echo 'clean ok'"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@nexa/config-typescript": "workspace:*",
    "@types/node": "^22.20.0",
    "cross-env": "^7.0.3",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
