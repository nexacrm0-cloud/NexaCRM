# Nexa CRM — .env.production
# Copiar a apps/api/.env y completar cada valor

# ==========================================
# APP / ENTORNO
# ==========================================
NODE_ENV=production
API_PORT=4000
FRONTEND_URL=https://app.tudominio.com

# ==========================================
# BASE DE DATOS / REDIS
# ==========================================
DATABASE_URL=postgresql://nexa:TU_PASSWORD_SEGURO@127.0.0.1:5432/nexacrm?schema=public
REDIS_URL=redis://:TU_REDIS_PASSWORD@127.0.0.1:6379

# ==========================================
# AUTH / JWT
# Generar con: openssl rand -base64 64
# ==========================================
JWT_SECRET=TU_JWT_SECRET_64_CHARS_BASE64
JWT_REFRESH_SECRET=TU_JWT_REFRESH_SECRET_64_CHARS_BASE64_DIFERENTE
INTERNAL_API_KEY=TU_INTERNAL_API_KEY_32_BYTES

# ==========================================
# FRONTEND / CORS
# ==========================================
FRONTEND_URL=https://app.tudominio.com

# ==========================================
# OPENAI / IA
# ==========================================
OPENAI_API_KEY=sk-TU_OPENAI_KEY
GROQ_API_KEY=gsk_TU_GROQ_KEY

# ==========================================
# EMAIL (Resend)
# ==========================================
RESEND_API_KEY=re_TU_RESEND_KEY
EMAIL_FROM=Nexa CRM <noreply@tudominio.com>

# ==========================================
# WHATSAPP BUSINESS (Meta)
# App ID / App Secret / Token en https://developers.facebook.com/apps/
# ==========================================
WHATSAPP_VERIFY_TOKEN=TU_VERIFY_TOKEN_32_CHARS
WHATSAPP_APP_SECRET=TU_APP_SECRET_DE_META
WHATSAPP_TOKEN=TU_TOKEN_PERMANENTE_DE_META

# ==========================================
# STRIPE (Payment Provider)
# Credenciales en https://dashboard.stripe.com/apikeys
# ==========================================
STRIPE_SECRET_KEY=sk_live_TU_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_TU_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_TU_WEBHOOK_SECRET

# ==========================================
# MERCADO PAGO (Payment Provider - Latam)
# Credenciales en https://www.mercadopago.com.ar/developers/panel/app
# Production Access Token = APP_USR-..., Test = TEST-...
# ==========================================
MP_ACCESS_TOKEN=APP_USR_TU_ACCESS_TOKEN
MP_WEBHOOK_URL=https://app.tudominio.com/api/v1/automation/webhooks/mercadopago
MP_WEBHOOK_SECRET=TU_WEBHOOK_SECRET
MP_API_BASE_URL=https://api.mercadopago.com
MP_SANDBOX_MODE=false

# ==========================================
# AFIP / FACTURACIÓN ELECTRÓNICA (Argentina)
# Certificados en: https://www.afip.gob.ar/certificados/
# Generar .p12 → openssl pkcs12 -in cert.p12 -out cert.pem -clcerts -nokeys
#                      openssl pkcs12 -in cert.p12 -out key.pem -nocerts -nodes
# ==========================================
AFIP_ENABLED=true
AFIP_PROVIDER_KIND=afipsdk
AFIP_CUIT=20345678901
AFIP_CERT_PATH=/app/certs/cert.pem
AFIP_KEY_PATH=/app/certs/key.pem
AFIP_ENV=production
ALLOW_STUB_AFIP_IN_PROD=

# ==========================================
# STORAGE (S3 / Cloudflare R2 / MinIO)
# ==========================================
AWS_ACCESS_KEY_ID=TU_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=TU_SECRET_KEY
AWS_S3_BUCKET=nexacrm-uploads
AWS_REGION=auto
AWS_ENDPOINT=https://TU_ACCOUNT.r2.cloudflarestorage.com

# ==========================================
# SENTRY (Error tracking)
# DSN en https://sentry.io/settings/<org>/projects/<project>/keys/
# Auth token en https://sentry.io/settings/auth-tokens/
# ==========================================
SENTRY_DSN=https://TU_KEY@sentry.io/TU_PROJECT_ID
NEXT_PUBLIC_SENTRY_DSN=https://TU_KEY@sentry.io/TU_PROJECT_ID_WEB
SENTRY_AUTH_TOKEN=TU_AUTH_TOKEN
SENTRY_RELEASE=  # se setea en CI: git rev-parse --short HEAD
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_HOST=sentry.io

# ==========================================
# FEATURE FLAGS
# ==========================================
WORKFLOWS_ENABLED=false
AFIP_ENABLED=true
AFIP_PROVIDER_KIND=afipsdk
AFIP_CUIT=20345678901
AFIP_CERT_PATH=/app/certs/cert.pem
AFIP_KEY_PATH=/app/certs/key.pem
AFIP_ENV=production
ALLOW_STUB_AFIP_IN_PROD=

# ==========================================
# STRIPE (opcional, alternativa internacional a Mercado Pago)
# ==========================================
# STRIPE_SECRET_KEY=sk_live_TU_KEY
# STRIPE_WEBHOOK_SECRET=whsec_TU_SECRET

# ==========================================
# OTROS
# ==========================================
EMAIL_FROM=Nexa CRM <noreply@tudominio.com>
INTERNAL_API_KEY=TU_INTERNAL_API_KEY_32_BYTES