NODE_ENV=development
API_PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://nexa:nexa123@localhost:5432/nexacrm?schema=public
# In prod, point DATABASE_URL at a role WITHOUT BYPASSRLS (nexa_app) so the
# Row Level Security policies installed by migration 20260808120000_enable_rls
# actually apply. The TenantMiddleware additionally does SET ROLE nexa_app on
# every request as defense-in-depth.
# Migrations/seeds use a separate DATABASE_MIGRATE_URL pointing at nexa_admin
# (BYPASSRLS) — see docker-compose.prod.yml.
REDIS_URL=redis://localhost:6379
# Override the role name the TenantMiddleware sets (rare; default: nexa_app):
# RLS_APP_ROLE=nexa_app

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

OPENAI_API_KEY=sk-your-openai-api-key
INTERNAL_API_KEY=change-this-in-production

# === WhatsApp Cloud API (agents/whatsapp_ai) ===
WHATSAPP_VERIFY_TOKEN=replace-with-32-random-bytes
# App secret from Meta for HMAC signature validation on webhooks
WHATSAPP_APP_SECRET=
# Permanent token from Meta for outbound messages (only set if you handle outbound via n8n directly)
WHATSAPP_TOKEN=

# === Outbound Mail / Email ===
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=no-reply@tudominio.com

# === Feature flags ===
# Workflows engine. Deteccion de ciclos pendiente (review gate 13.1).
# Mantener en "false" en produccion hasta que se implemente protection.
WORKFLOWS_ENABLED=true
# Si se usa StubPaymentProvider en produccion (solo alpha/piloto).
# En prod, sin esta flag, la app se niega a arrancar.
ALLOW_STUB_PAYMENT_IN_PROD=
# Forzar seeds de datos demo en prod (peligroso: credenciales conocidas).
SEED_DEMO_IN_PROD=

# === Provider de pagos ===
# Valores: "stub" (dev/alpha) | "stripe" (produccion real) | "mercadopago" (produccion real Latam)
PAYMENT_PROVIDER_KIND=stub

# === Stripe ===
# Clave secreta de Stripe (sk_test_... o sk_live_...)
STRIPE_SECRET_KEY=
# Clave publicable de Stripe (pk_test_... o pk_live_...) - para el frontend
STRIPE_PUBLISHABLE_KEY=
# Secreto del webhook de Stripe (whsec_...) - configurar en Stripe Dashboard -> Webhooks
STRIPE_WEBHOOK_SECRET=

# === Mercado Pago ===
# Access token de tu app en https://www.mercadopago.com.ar/developers/panel/app
# Production Access Token = APP_USR-..., Test = TEST-...
MP_ACCESS_TOKEN=
# Modo sandbox (recomendado para pruebas): "true" o "false"
MP_SANDBOX_MODE=false
# URL publica donde MP envia webhooks. Debe apuntar a /api/v1/automation/webhooks/mercadopago
MP_WEBHOOK_URL=https://app.nexacrm.com/api/v1/automation/webhooks/mercadopago
# Secreto opcional para validar firma del webhook (HMAC)
MP_WEBHOOK_SECRET=
# Override base URL (deploy LATAM multi-pais: https://api.mercadopago.com)
MP_API_BASE_URL=https://api.mercadopago.com

# === AFIP / Facturacion electronica (Argentina) ===
# "true" habilita el llamado a AFIP al emitir facturas. "false" emite sin CAE.
AFIP_ENABLED=false
# Provider: "stub" (CAE ficticio, dev/alpha) | "afipsdk" (WSFE real)
AFIP_PROVIDER_KIND=stub
# CUIT del emisor (sin guiones)
AFIP_CUIT=
# Certificado X.509 PEM y clave privada PEM (de AFIP: Administracion de Certificados)
AFIP_CERT_PATH=
AFIP_KEY_PATH=
# Entorno: "testing" (homologacion) | "production"
AFIP_ENV=testing
# Permitir stub en produccion (solo alpha, facturas sin validez fiscal)
ALLOW_STUB_AFIP_IN_PROD=

# === Sentry (observabilidad) ===
# DSN del proyecto en https://sentry.io/settings/<org>/projects/<project>/keys/
# Sin DSN, el SDK se inicializa en modo no-op (no falla, no manda nada)
SENTRY_DSN=
# Release/commit SHA para source maps. CI puede setear: git rev-parse --short HEAD
SENTRY_RELEASE=
# Sample rates (0.0 - 1.0). En prod recomendamos 0.1 en alpha; 0.05 en beta
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
