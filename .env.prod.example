# Nexa CRM — Producción
# Copia a .env.prod y completa cada valor.

# === Dominio / Frontend ===
FRONTEND_URL=https://app.nexacrm.com
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGIN=https://app.nexacrm.com

# === Base de datos ===
POSTGRES_USER=nexa
POSTGRES_PASSWORD=__PLEASE_CHANGE__
POSTGRES_DB=nexacrm

# === Redis ===
REDIS_PASSWORD=__PLEASE_CHANGE__

# === Secrets JWT ===
# Generar con: openssl rand -base64 64
JWT_SECRET=__PLEASE_CHANGE_TO_64_BASE64_CHARS__
JWT_REFRESH_SECRET=__PLEASE_CHANGE_DIFFERENT_64_BASE64_CHARS__

# === API / Auth ===
INTERNAL_API_KEY=__PLEASE_CHANGE_TO_RANDOM_32_BYTES__

# === WhatsApp Business ===
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=

# === Email (Resend) ===
RESEND_API_KEY=
EMAIL_FROM=Nexa CRM <noreply@nexacrm.com>

# === AI ===
OPENAI_API_KEY=
GROQ_API_KEY=

# === Storage (S3/R2 compatible) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=auto
AWS_ENDPOINT=

# === Feature flags ===
# Mantener en false hasta que se implemente deteccion de ciclos
WORKFLOWS_ENABLED=false
# Solo "1" si es alpha/piloto y se acepta no cobrar de verdad
ALLOW_STUB_PAYMENT_IN_PROD=

# === Provider de pagos ===
# Valores: "stub" (dev/alpha) | "mercadopago" (produccion real)
PAYMENT_PROVIDER_KIND=mercadopago

# === Mercado Pago ===
# Access token: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=
MP_SANDBOX_MODE=false
MP_WEBHOOK_URL=https://app.nexacrm.com/api/v1/automation/webhooks/payments
MP_WEBHOOK_SECRET=
MP_API_BASE_URL=https://api.mercadopago.com

# === Sentry ===
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_HOST=sentry.io
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Auth token para source map upload desde el CI
SENTRY_AUTH_TOKEN=

# === AFIP / Facturacion electronica ===
AFIP_ENABLED=false
AFIP_PROVIDER_KIND=stub
AFIP_CUIT=
AFIP_CERT_PATH=
AFIP_KEY_PATH=
AFIP_ENV=testing
ALLOW_STUB_AFIP_IN_PROD=
