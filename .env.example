# ---- Database roles (Row Level Security) -----------------------------------
# Two DATABASE_URLs are required in production:
#
#   DATABASE_URL (used by the `api` service at runtime)
#     Role: nexa_app (NOLOGIN/BYPASSRLS-fail). The TenantMiddleware does
#     SET ROLE nexa_app on every request so every query is filtered by the
#     RLS policies in migration 20260808120000_enable_rls. If you point
#     this at a role with BYPASSRLS, RLS silently does nothing.
#
#   DATABASE_MIGRATE_URL (used by the `migrate` service + seeds)
#     Role: nexa_admin (BYPASSRLS). Used only for schema changes, backfills,
#     and seed scripts that need cross-tenant access. In dev you can keep
#     both URLs pointing at the same role (postgres superuser) since prod
#     isolation isn't needed locally.
#
# Example dev (single superuser role):
DATABASE_URL=postgresql://nexa:nexa123@localhost:55432/nexacrm?schema=public
# Example prod (two roles, see migration 20260808120000_enable_rls):
#   DATABASE_URL=postgresql://nexa_app:APP_PASSWORD@db:5432/nexacrm?schema=public
#   DATABASE_MIGRATE_URL=postgresql://nexa_admin:ADMIN_PASSWORD@db:5432/nexacrm?schema=public
# Optional: override the role name the middleware sets (rare; only if you
# renamed nexa_app in the migration):
# RLS_APP_ROLE=nexa_app

# API
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Internal
INTERNAL_API_KEY=change-this-in-production

# WhatsApp
WHATSAPP_VERIFY_TOKEN=nexa_whatsapp_verify_2026

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Email
EMAIL_FROM=no-reply@tudominio.com

# Stripe (Payment Provider)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
