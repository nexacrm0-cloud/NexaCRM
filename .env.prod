# Nexa CRM — Producción
# Copia a .env.prod y completa cada valor.

# === Dominio / Frontend ===
FRONTEND_URL=https://app.nexacrm.com
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGIN=https://app.nexacrm.com

# === Base de datos ===
POSTGRES_USER=nexa
POSTGRES_PASSWORD=__PLEASE_CHANGE__
POSTGRES_DB=nexacrm

# === Redis ===
REDIS_PASSWORD=__PLEASE_CHANGE__

# === Secrets JWT ===
# Generar con: openssl rand -base64 64
JWT_SECRET=__PLEASE_CHANGE_TO_64_BASE64_CHARS__
JWT_REFRESH_SECRET=__PLEASE_CHANGE_DIFFERENT_64_BASE64_CHARS__

# === API / Auth ===
INTERNAL_API_KEY=__PLEASE_CHANGE_TO_RANDOM_32_BYTES__

# === WhatsApp Business ===
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=

# === Email (Resend) ===
RESEND_API_KEY=
EMAIL_FROM=Nexa CRM <noreply@nexacrm.com>

# === AI ===
OPENAI_API_KEY=
GROQ_API_KEY=

# === Storage (S3/R2 compatible) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=auto
AWS_ENDPOINT=

# === Feature flags ===
# Mantener en false hasta que se implemente deteccion de ciclos
WORKFLOWS_ENABLED=false
# Solo "1" si es alpha/piloto y se acepta no cobrar de verdad
ALLOW_STUB_PAYMENT_IN_PROD=
